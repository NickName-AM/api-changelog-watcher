{
  "name": "api-changelog-watcher",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types --strict-vars=false >/dev/null && tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "probe": "tsx scripts/probe.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
